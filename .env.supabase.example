# Copy values from the Frankfurt project's Connect dialog into an ignored
# .env.supabase.local file. Never put real credentials in this example.
# This file is NOT automatically loaded and does not switch the live website.
SUPABASE_PROJECT_REF="nvfbyhprwiyigdcqgjtd"
NEXT_PUBLIC_SITE_URL="https://www.vibroabsorber.com"

# Runtime only. The host was verified in this project's Connect dialog.
# The application passes the pinned official CA to node-postgres and enforces TLS.
DATABASE_URL="postgresql://vibro_runtime.nvfbyhprwiyigdcqgjtd:URL_ENCODED_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&sslaccept=strict&connection_limit=3"

# Same restricted runtime identity on the session pooler, for compatible tools.
# This role cannot run migrations or full backups. Keep admin credentials separate.
DIRECT_URL="postgresql://vibro_runtime.nvfbyhprwiyigdcqgjtd:URL_ENCODED_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require&sslaccept=strict&connection_limit=3"

# Local account/inquiry integration only. Enable after Auth email/redirect setup.
# Publishable key only; NEVER put a secret/service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL="https://nvfbyhprwiyigdcqgjtd.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"
INQUIRY_PORTAL_ENABLED="false"
