# Copy only needed values into an ignored local/deployment environment.
# Application notifications use ZeptoMail's HTTPS API on port 443.
# Copy the Agent-specific Send Mail Token from Agents > SMTP/API > API.
ZEPTOMAIL_API_ENABLED=false
ZEPTOMAIL_SEND_TOKEN=
ZEPTOMAIL_API_TIMEOUT_MS=10000
# Sender is the confirmed service@vibroabsorber.com. Domain must be verified in ZeptoMail.
# Supabase Auth SMTP remains configured separately in its dashboard.

# Durable notification worker. Keep disabled until explicitly activated.
NOTIFICATION_WORKER_ENABLED=false
SUPABASE_SECRET_KEY=
CRON_SECRET=
NOTIFICATION_WORKER_BATCH_SIZE=10
NOTIFICATION_WORKER_LEASE_SECONDS=300
# Shared staff mailbox; this first-stage worker uses the first valid address only.
NOTIFICATION_STAFF_EMAILS=

# Optional internal Feishu/Lark bot. Message bodies intentionally omit customer PII.
FEISHU_WEBHOOK_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SIGNING_SECRET=
FEISHU_TIMEOUT_MS=5000
